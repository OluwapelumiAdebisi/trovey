# Canonical URL for the sitemap, robots.txt, and Open Graph tags.
# TODO: Replace with the real domain before launch.
NEXT_PUBLIC_SITE_URL=https://trovey.com

# Option A — browser posts JSON straight to Formspree (or a similar service).
# Example: https://formspree.io/f/xxxxxxxx
# TODO: Plug in your form endpoint before collecting real signups.
# Until one of these is set, /api/early-access accepts the request and does not store it.
NEXT_PUBLIC_FORM_ENDPOINT=

# Option B — keep the URL off the client. The site posts to /api/early-access,
# and that route forwards JSON to FORM_ENDPOINT.
# Use Option A or Option B, not both. If both are set, Option A wins.
FORM_ENDPOINT=
